# Required. Export these in your shell (for example: set -a; source .env; set +a).
# Your Azure OpenAI endpoint URL:
AZURE_OPENAI_ENDPOINT=
# Your Azure OpenAI key:
AZURE_OPENAI_API_KEY=

# Optional. Uncomment only to change the default shown; an empty value also means the default.
# FOOTNOTE_AGENT_DEPLOYMENT=footnote-agent
# FOOTNOTE_GRADER_DEPLOYMENT=footnote-grader
# FOOTNOTE_CACHE=~/.cache/footnote
